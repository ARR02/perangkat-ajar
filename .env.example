# Database (Supabase PostgreSQL)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?pgbouncer=true
DATABASE_URL=""
DIRECT_URL=""  # Direct connection without connection pooling for better performance

# NextAuth
AUTH_SECRET=""  # generate with: openssl rand -base64 32
NEXTAUTH_URL="https://your-app.vercel.app"

# AI Provider (gemini, openai, etc.)
AI_PROVIDER="gemini"
AI_API_KEY=""
AI_MODEL="gemini-3.7-flash"
AI_TIMEOUT_MS="60000"
AI_MAX_RETRIES="2"

# Storage (optional - for file uploads)
STORAGE_URL=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="perangkat-ajar"